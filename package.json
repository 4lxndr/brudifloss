{
  "name": "brudiflos",
  "private": true,
  "license": "WTFPL",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --minify --target=es2020 --format=iife --outfile=.build/game.js && javascript-obfuscator .build/game.js --output public/game.js --compact true --control-flow-flattening true --control-flow-flattening-threshold 0.3 --string-array true --string-array-threshold 0.6 --identifier-names-generator hexadecimal",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker && tsc --noEmit -p test",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"public/*.{html,css}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"public/*.{html,css}\"",
    "dev": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^5.20260820.1",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.1",
    "javascript-obfuscator": "^4.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "~3.2.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "esbuild@0.27.3": true,
    "sharp@0.34.5": true,
    "sharp@0.35.2": true,
    "workerd@1.20260310.1": true
  }
}
